{
  "name": "field-archaeology-digital-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:dating": "node -e \"const fs=require('fs');let s=fs.readFileSync('scripts/dating-check.cjs','utf8');s=s.replace(\\\"require('./src/data/dating/state-machine.ts')\\\",\\\"require('../src/data/dating/state-machine.ts')\\\").replace(\\\"require('./src/api/dating-service.ts')\\\",\\\"require('../src/api/dating-service.ts')\\\").replace(\\\"require('./src/api/local-service.ts')\\\",\\\"require('../src/api/local-service.ts')\\\");fs.writeFileSync('scripts/.dating-check.run.cjs',\\\"require('./ts-register.cjs');\\\\n\\\"+s)\" && node scripts/.dating-check.run.cjs"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  }
}
